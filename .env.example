# ─── Server-only (Vercel serverless functions in /api) ───────────────────────
# Set these in Vercel → Project Settings → Environment Variables, or in a local
# .env file for `vercel dev`. NEVER prefix them with VITE_: anything VITE_* is
# inlined into the public JS bundle.

# Neon Postgres connection string (used only by api/portfolio.js)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# CMS admin password (checked only by api/auth.js)
CMS_ADMIN_PASSWORD="<choose-a-strong-password>"

# Secret used to sign CMS session tokens. Recommended: a long random string,
# e.g. `openssl rand -base64 32`. Falls back to CMS_ADMIN_PASSWORD if unset.
CMS_AUTH_SECRET="<long-random-string>"

# ─── Client (public, bundled into the site) ──────────────────────────────────
# Cloudinary (Optional - can also be configured directly in CMS UI)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
