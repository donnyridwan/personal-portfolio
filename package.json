{
  "name": "dockfolio",
  "version": "0.1.0",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "npm run build:editor && npm run build:pdf && next dev",
    "build": "npm run build:editor && npm run build:pdf && next build",
    "start": "next start",
    "test": "vitest run && node --test tests/*.test.mjs",
    "build:editor": "esbuild editor-src/editor.js --bundle --format=esm --minify --target=es2020 --outfile=public/editor/editor.js",
    "build:pdf": "node -e \"const fs=require('fs');fs.mkdirSync('public/pdfjs',{recursive:true});for(const f of ['pdf.min.mjs','pdf.worker.min.mjs'])fs.copyFileSync('node_modules/pdfjs-dist/build/'+f,'public/pdfjs/'+f)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donnyridwan/personal-portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/donnyridwan/personal-portfolio/issues"
  },
  "homepage": "https://github.com/donnyridwan/personal-portfolio#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@neondatabase/serverless": "^1.2.1",
    "next": "^16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-bubble-menu": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
